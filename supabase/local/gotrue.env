# LOCAL DEV HARNESS ONLY — Supabase Auth (GoTrue) against the local Postgres. Never use these values in production.
GOTRUE_API_HOST=127.0.0.1
PORT=54323
GOTRUE_DB_DRIVER=postgres
DATABASE_URL="postgres://sameer@localhost:5432/merta_deal?sslmode=disable&search_path=auth"
GOTRUE_DB_NAMESPACE=auth
GOTRUE_JWT_SECRET=merta-deal-local-dev-secret-at-least-32-chars!!
GOTRUE_JWT_EXP=3600
GOTRUE_JWT_AUD=authenticated
GOTRUE_JWT_DEFAULT_GROUP_NAME=authenticated
GOTRUE_JWT_ADMIN_ROLES=service_role,supabase_admin
GOTRUE_SITE_URL=http://localhost:3000
GOTRUE_URI_ALLOW_LIST=http://localhost:3000/*
API_EXTERNAL_URL=http://localhost:54321/auth/v1
GOTRUE_DISABLE_SIGNUP=false
GOTRUE_EXTERNAL_EMAIL_ENABLED=true
GOTRUE_MAILER_AUTOCONFIRM=true
GOTRUE_EXTERNAL_PHONE_ENABLED=true
GOTRUE_SMS_AUTOCONFIRM=true
GOTRUE_EXTERNAL_ANONYMOUS_USERS_ENABLED=true
GOTRUE_PASSWORD_MIN_LENGTH=6
GOTRUE_LOG_LEVEL=warn
GOTRUE_RATE_LIMIT_EMAIL_SENT=1000
GOTRUE_RATE_LIMIT_SMS_SENT=1000
GOTRUE_SMTP_HOST=localhost
GOTRUE_SMTP_PORT=2500
GOTRUE_SMTP_ADMIN_EMAIL=help@mertadeal.in
