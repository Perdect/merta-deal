{
  "name": "Merta Deal — Merta Ki Shopping, Ab Online",
  "short_name": "Merta Deal",
  "description": "Groceries, fruits and vegetables in Merta City, delivered in 20–25 minutes.",
  "id": "/",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#F7F7F4",
  "theme_color": "#329537",
  "lang": "en-IN",
  "dir": "ltr",
  "categories": ["shopping", "food"],
  "launch_handler": { "client_mode": "navigate-existing" },
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Search groceries", "short_name": "Search", "url": "/search?source=pwa", "description": "Find atta, dal, milk, snacks", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "My orders", "short_name": "Orders", "url": "/account/orders?source=pwa", "description": "Track your deliveries", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Cart", "short_name": "Cart", "url": "/cart?source=pwa", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ]
}
